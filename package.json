{
  "name": "dg-scss-color-preview",
  "displayName": "DG SCSS Color Preview",
  "description": "Underline color previews for SCSS variables, CSS custom properties, and color literals.",
  "version": "0.1.7",
  "publisher": "Azragh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azragh/dg-scss-color-preview.git"
  },
  "homepage": "https://github.com/azragh/dg-scss-color-preview",
  "bugs": {
    "url": "https://github.com/azragh/dg-scss-color-preview/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:css"
  ],
  "main": "./src/extension.js",
  "icon": "img/thumbnail.png",
  "files": [
    "src",
    "img",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "scssColorPreview.refresh",
        "title": "SCSS Color Preview: Refresh"
      }
    ],
    "configuration": {
      "title": "SCSS Color Preview",
      "properties": {
        "scssColorPreview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline color swatches for SCSS variables and CSS custom properties."
        },
        "scssColorPreview.maxFiles": {
          "type": "number",
          "default": 300,
          "description": "Maximum number of CSS/SCSS files to scan in the workspace."
        }
      }
    }
  }
}
